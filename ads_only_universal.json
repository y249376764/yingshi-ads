[
 {
  "name": "通用-广告片段过滤",
  "hosts": [
   ""
  ],
  "regex": [
   "#EXTINF:\\s*([0-4]\\.\\d+|5\\.0),.*?(ad|promo|preroll|midroll|postroll)",
   "#EXT-X-DISCONTINUITY[^#]*#EXTINF[^#]*adjump"
  ]
 },
 {
  "name": "通用·广告目录 /ad/ /ads/ /adv/",
  "hosts": [
   ""
  ],
  "regex": [
   "#EXTINF.*?\\s+.*?/ads?/.*?\\.ts.*?\\s+",
   "#EXTINF.*?\\s+.*?/adv/.*?\\.ts.*?\\s+",
   "#EXTINF.*?\\s+.*?/advert/.*?\\.ts.*?\\s+"
  ]
 },
 {
  "name": "通用·贴片关键词 preroll/midroll",
  "hosts": [
   ""
  ],
  "regex": [
   "#EXTINF.*?\\s+.*?(preroll|midroll|commercial).*?\\.ts.*?\\s+"
  ]
 },
 {
  "name": "通用·混淆名 1o/p1ayer/gg/ad",
  "hosts": [
   ""
  ],
  "regex": [
   "#EXTINF.*?\\s+.*?/(1o|gg|p1ayer|guanggao)[0-9]*\\.ts.*?\\s+",
   "#EXTINF.*?\\s+.*?/ad[0-9]*\\.ts.*?\\s+"
  ]
 },
 {
  "name": "通用·adjump 跳转广告",
  "hosts": [
   ""
  ],
  "regex": [
   "#EXTINF.*?\\s+.*?adjump.*?\\.ts.*?\\s+"
  ]
 },
 {
  "name": "通用·SCTE35 CUE-OUT 广告段",
  "hosts": [
   ""
  ],
  "regex": [
   "#EXT-X-CUE-OUT[\\s\\S]*?#EXT-X-CUE-IN"
  ]
 }
]